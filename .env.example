# ============================================================
# Configuración del Backend (copiar a .env y completar)
# ============================================================

# String de conexión PostgreSQL.
# - Local (Docker): postgresql://postgres:postgres@localhost:5432/farmacia
# - Supabase: Project Settings > Database > Connection string > URI.
#   Usá el SESSION POOLER (puerto 5432), compatible con IPv4 (Render, VPS, etc.):
#   postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmacia

# Fuerza SSL de la conexión a la base:
#   true  -> siempre SSL (Supabase / proveedores cloud)
#   false -> sin SSL (Postgres local)
#   vacío -> auto-detección (localhost = sin SSL)
DATABASE_SSL=

# Tamaño máximo del pool de conexiones
DATABASE_POOL_MAX=10

# Puerto HTTP donde escucha Fastify
PORT=3000

# development | production | test
NODE_ENV=development

# Orígenes autorizados para CORS (separados por coma). Usar * solo en desarrollo.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Clave que protege el endpoint de carga de precios (POST .../precios/csv).
# Si se define, cada petición debe enviar el header:  x-api-key: <clave>
# Generá una segura con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dejar vacía SOLO en desarrollo local (queda abierta y se registra un warning).
ADMIN_API_KEY=

# URL pública del FRONTEND desplegado. Se usa para armar los códigos QR
# de los carteles PDF: {PUBLIC_APP_URL}/?sucursal=SUC-001
PUBLIC_APP_URL=http://localhost:5500
