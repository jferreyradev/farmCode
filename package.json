{
  "name": "lista-precios-res-conjunta-2-2025",
  "version": "1.0.0",
  "description": "Sistema de lista de precios de medicamentos con QR para cumplimiento de la Resolución Conjunta 2/2025 (Argentina)",
  "private": true,
  "type": "module",
  "main": "dist/backend/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/backend/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/server.js",
    "poster": "node scripts/generate-poster.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.13.8",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
